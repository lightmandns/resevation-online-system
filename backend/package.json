{
  "name": "express-mssql-backend",
  "version": "1.0.0",
  "description": "Express.js REST API with SQL Server & User Management (TypeScript)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "docs:gen": "tsx src/docs/swagger.ts",
    "predev": "npm run docs:gen",
    "dev": "tsx watch src/server.ts",
    "db:test": "tsx src/scripts/testDb.ts",
    "db:init": "tsx src/scripts/initDb.ts",
    "drizzle:studio": "drizzle-kit studio",
    "test:auth": "tsx src/scripts/testAuthDrizzle.ts"
  },
  "keywords": [
    "express",
    "sql-server",
    "mssql",
    "jwt",
    "auth",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^1.0.0-rc.5-5935859",
    "drizzle-orm": "^1.0.0-rc.5-5935859",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
