# Server Port
PORT=5000
NODE_ENV=development

# SQL Server Configuration
# Note: For SQL Express on localhost, use DB_SERVER=localhost\\SQLEXPRESS or localhost
DB_USER=sa
DB_PASSWORD=Password123
DB_SERVER=localhost
DB_DATABASE=UserManagementDB
DB_PORT=1433

# Additional MSSQL Options
# DB_ENCRYPT=false (Set to true if using Azure SQL Server)
DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true (Recommended for local development with self-signed SSL certs)
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Secret & Expiration
JWT_SECRET=super_secret_jwt_key_please_change_in_production_12345
JWT_EXPIRES_IN=1d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
